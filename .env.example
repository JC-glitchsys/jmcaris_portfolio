# ── Frontend (apps/web) ─────────────────────────────────────────────
# Public URL of the deployed chat Worker. This is NOT a secret: it is visible in the browser.
# Copy to apps/web/.env.local for local dev (optional; dev falls back to http://localhost:8787).
VITE_CHAT_API_URL=https://jmcaris-gemini-chat.jmcaris-portfolio-2027.workers.dev

# ── Worker (workers/gemini-chat) ────────────────────────────────────
# SECRET. Never put it in a VITE_ variable and never commit it.
#   local:      workers/gemini-chat/.dev.vars   (see .dev.vars.example)
#   production: npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=
